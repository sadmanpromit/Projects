{
  "manifest_version": 3,
  "name": "YouTube Playlist Importer",
  "version": "1.4.1",
  "description": "Import direct YouTube video links from a local Excel workbook into a playlist you choose, with verified saves and queue recovery.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "YouTube Playlist Importer • open queue"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
